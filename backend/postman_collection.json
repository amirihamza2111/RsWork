                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Diner\",\n  \"email\": \"diner@test.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register Restaurant (onboarding)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-restaurant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register-restaurant"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantName\": \"My Bistro\",\n  \"name\": \"Owner\",\n  \"email\": \"owner@bistro.com\",\n  \"password\": \"password123\",\n  \"currency\": \"TND\",\n  \"language\": \"fr\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.environment.set('token', d.token);",
                  "pm.environment.set('restaurantId', d.restaurant._id);",
                  "if (d.verifyToken) pm.environment.set('verifyToken', d.verifyToken);"
                ]
              }
            }
          ]
        },
