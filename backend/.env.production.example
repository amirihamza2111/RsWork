# RsWork backend — PRODUCTION environment (set these in Render, never commit real values).
# Only the values marked "SECRET" must be pasted by you; the rest have safe defaults.

NODE_ENV=production
# PORT is provided automatically by Render — do NOT set it.

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # SECRET — secret / service_role key
SUPABASE_DB_URL=             # SECRET — transaction pooler connection string (port 6543)
SUPABASE_STORAGE_BUCKET=menu-images

# ---- URLs / CORS ----
CLIENT_URL=https://app.rswork.com          # your live frontend (used to build table QR links)
CORS_ORIGINS=https://app.rswork.com        # comma-separated allowed origins
ALLOW_VERCEL_PREVIEWS=false

# ---- Stripe (live keys for production) ----
STRIPE_SECRET_KEY=           # SECRET — sk_live_...
STRIPE_PUBLISHABLE_KEY=      # pk_live_... (served to the diner app for card payment)
STRIPE_WEBHOOK_SECRET=       # SECRET — from the live webhook endpoint you create
STRIPE_CURRENCY=usd

# ---- Forecast microservice (internal Render URL) ----
ML_SERVICE_URL=https://rswork-ml.onrender.com
ML_TIMEOUT_MS=4000

# ---- Email (Resend + your verified domain) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=              # SECRET
EMAIL_FROM=RsWork <no-reply@your-verified-domain.com>
EMAIL_TIMEOUT_MS=15000

# ---- AI report (Groq) ----
AI_PROVIDER=groq
GROQ_API_KEY=                # SECRET
AI_TIMEOUT_MS=20000

# ---- Web Push (VAPID) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=           # SECRET
VAPID_CONTACT=mailto:admin@rswork.com

# ---- Error tracking (Sentry) ----
SENTRY_DSN=                  # backend project DSN

# ---- Anti-abuse caps ----
MAX_ACTIVE_ORDERS_PER_TABLE=5
MAX_OPEN_TAB_AMOUNT=1000
