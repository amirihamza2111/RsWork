# ---- Core (required) ----
NODE_ENV=development
PORT=5000
DB_URI=mongodb://localhost:27017/restaurant
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Public URL of the frontend (also used to build table QR links).
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins. Falls back to CLIENT_URL if unset.
CORS_ORIGINS=http://localhost:5173
# Set to "true" to also allow any *.vercel.app preview origin.
ALLOW_VERCEL_PREVIEWS=false

# ---- Stripe (optional — leave blank to run cash-only) ----
STRIPE_SECRET_KEY=
# Publishable key (pk_...) — served to the diner app; blank hides online card pay
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=usd
# From the Stripe dashboard (or `stripe listen`) — enables the payment webhook
STRIPE_WEBHOOK_SECRET=

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Forecast microservice (optional — falls back to built-in forecast) ----
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=4000

# ---- Email (optional — sends are skipped/logged when blank) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Use "RsWork <onboarding@resend.dev>" for testing, or your verified domain sender
EMAIL_FROM=RsWork <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=15000

# ---- AI report (optional — falls back to a template narrative) ----
# Provider: "gemini" or "groq". Groq's free tier works worldwide (incl. regions
# where Gemini's free tier is unavailable). Get a free key at console.groq.com.
AI_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
# Leave AI_MODEL blank to use the per-provider default
# (gemini -> gemini-2.0-flash, groq -> llama-3.3-70b-versatile).
AI_MODEL=
AI_TIMEOUT_MS=20000

# ---- Error tracking (optional — Sentry no-ops when DSN is blank) ----
# Project Client Key (DSN): Sentry > Settings > Projects > [project] > Client Keys.
SENTRY_DSN=

# ---- Web Push / PWA notifications (optional — disabled when blank) ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@rswork.com

# ---- QR-order anti-abuse caps ----
MAX_ACTIVE_ORDERS_PER_TABLE=5
MAX_OPEN_TAB_AMOUNT=1000
