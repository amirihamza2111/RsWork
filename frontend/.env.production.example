# RsWork frontend — PRODUCTION build env (set these in Vercel → Project Settings
# → Environment Variables; they must exist BEFORE the build runs).
# Vite inlines VITE_* at build time, so a rebuild is required after changing them.

# Supabase project URL + publishable key (public values).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stripe publishable key (pk_live_… / pk_test_…) — blank disables online card payment.
VITE_STRIPE_PUBLISHABLE_KEY=
