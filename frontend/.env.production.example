# RsWork frontend — PRODUCTION build env (set these in Netlify → Site configuration
# → Environment variables; they must exist BEFORE the build runs).
# Vite inlines VITE_* at build time, so a rebuild is required after changing them.

# The deployed backend API base URL (Render).
VITE_API_URL=https://rswork-api.onrender.com

# Supabase project URL + publishable key (Auth sessions and Realtime).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Web Push public key (must match the backend VAPID_PUBLIC_KEY).
VITE_VAPID_PUBLIC_KEY=

# Sentry frontend (React) project DSN — blank disables error tracking.
VITE_SENTRY_DSN=
